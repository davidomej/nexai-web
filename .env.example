# Puerto en el que arranca el servidor (Coolify lo sobreescribe automáticamente)
PORT=3000

# Email donde llegan las solicitudes del formulario
CONTACT_EMAIL=tu@email.com

# API key de Resend (https://resend.com) — envío de email por HTTPS
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente. Para probar sin verificar dominio usa onboarding@resend.dev
# (solo entrega al email con el que registraste la cuenta de Resend).
# Para producción verifica tu dominio en Resend y usa, p.ej.: Nexa AI <web@nexaai.es>
EMAIL_FROM=Nexa AI <onboarding@resend.dev>

# Número de WhatsApp del negocio para el botón flotante, en formato
# internacional sin espacios ni símbolos (ej: 34600000000)
WHATSAPP_NUMBER=34600000000
